 } VmSock;
 
 
+// --- per-JVM SOCKS5 proxy ------------------------------------------------
+// These titles talk to a game server that is often only reachable from a
+// proxy in the server's region, and the MIDlet has no API to configure one.
+// connect0 therefore opens the proxy connection and performs the RFC 1928
+// handshake before giving the socket back to the guest, so every
+// Connector.open("socket://...") and http request tunnels transparently.
+// HTTPS (sslc_connect) builds its own connection and is not covered.
+#define JNI_IO_MAX_PROXY_JVMS 32
+typedef struct {
+    MiniJVM *jvm;
+    int port;
+    char host[256];
+    char user[128];
+    char pass[128];
+} JniProxyEntry;
+static JniProxyEntry g_proxies[JNI_IO_MAX_PROXY_JVMS];
+static mtx_t g_proxy_lock;
+
+static void proxy_init(void) {
+    static int inited = 0;
+    if (!inited) {
+        for (int i = 0; i < JNI_IO_MAX_PROXY_JVMS; i++) {
+            g_proxies[i].jvm = NULL;
+        }
+        mtx_init(&g_proxy_lock, mtx_plain);
+        inited = 1;
+    }
+}
+
+// An empty host disables the proxy for that JVM.
+void jni_io_set_proxy_for_jvm(MiniJVM *jvm, const char *host, int port, const char *user, const char *pass) {
+    if (!jvm) return;
+    proxy_init();
+    int enabled = host && host[0] && port > 0 && port < 65536;
+    mtx_lock(&g_proxy_lock);
+    int mine = -1, free_slot = -1;
+    for (int i = 0; i < JNI_IO_MAX_PROXY_JVMS; i++) {
+        if (g_proxies[i].jvm == jvm) {
+            mine = i;
+            break;
+        }
+        if (!g_proxies[i].jvm && free_slot < 0) free_slot = i;
+    }
+    if (mine < 0) {
+        if (!enabled) {
+            mtx_unlock(&g_proxy_lock);
+            return;
+        }
+        mine = free_slot;
+        if (mine < 0) {
+            mtx_unlock(&g_proxy_lock);
+            printf("[SOCKS] no free proxy entry for jvm %p\n", (void *) jvm);
+            return;
+        }
+    }
+    if (!enabled) {
+        g_proxies[mine].jvm = NULL;
+        mtx_unlock(&g_proxy_lock);
+        printf("[SOCKS] proxy disabled\n");
+        return;
+    }
+    g_proxies[mine].jvm = jvm;
+    g_proxies[mine].port = port;
+    snprintf(g_proxies[mine].host, sizeof(g_proxies[mine].host), "%s", host);
+    snprintf(g_proxies[mine].user, sizeof(g_proxies[mine].user), "%s", user ? user : "");
+    snprintf(g_proxies[mine].pass, sizeof(g_proxies[mine].pass), "%s", pass ? pass : "");
+    mtx_unlock(&g_proxy_lock);
+    printf("[SOCKS] proxy set to %s:%d%s\n", host, port, (user && user[0]) ? " (auth)" : "");
+}
+
+void jni_io_clear_proxy_for_jvm(MiniJVM *jvm) {
+    if (!jvm) return;
+    proxy_init();
+    mtx_lock(&g_proxy_lock);
+    for (int i = 0; i < JNI_IO_MAX_PROXY_JVMS; i++) {
+        if (g_proxies[i].jvm == jvm) {
+            g_proxies[i].jvm = NULL;
+            break;
+        }
+    }
+    mtx_unlock(&g_proxy_lock);
+}
+
+static int proxy_snapshot(MiniJVM *jvm, char *host, size_t host_size, int *port,
+                          char *user, size_t user_size, char *pass, size_t pass_size) {
+    if (!jvm) return 0;
+    proxy_init();
+    int found = 0;
+    mtx_lock(&g_proxy_lock);
+    for (int i = 0; i < JNI_IO_MAX_PROXY_JVMS; i++) {
+        if (g_proxies[i].jvm == jvm) {
+            snprintf(host, host_size, "%s", g_proxies[i].host);
+            snprintf(user, user_size, "%s", g_proxies[i].user);
+            snprintf(pass, pass_size, "%s", g_proxies[i].pass);
+            *port = g_proxies[i].port;
+            found = 1;
+            break;
+        }
+    }
+    mtx_unlock(&g_proxy_lock);
+    return found;
+}
+
+static s32 socks_write(mbedtls_net_context *ctx, const unsigned char *buf, s32 len) {
+    s32 sent = 0;
+    while (sent < len) {
+        int n = mbedtls_net_send(ctx, buf + sent, (size_t) (len - sent));
+        if (n == MBEDTLS_ERR_SSL_WANT_READ || n == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+        if (n <= 0) return -1;
+        sent += n;
+    }
+    return 0;
+}
+
+static s32 socks_read(mbedtls_net_context *ctx, unsigned char *buf, s32 len) {
+    s32 got = 0;
+    while (got < len) {
+        int n = mbedtls_net_recv(ctx, buf + got, (size_t) (len - got));
+        if (n == MBEDTLS_ERR_SSL_WANT_READ || n == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+        if (n <= 0) return -1;
+        got += n;
+    }
+    return 0;
+}
+
+static int socks5_tunnel(mbedtls_net_context *ctx, const char *host, s32 host_len,
+                         s32 port, const char *user, const char *pass) {
+    unsigned char buf[600];
+    int has_auth = user && user[0];
+
+    // The engine hands over a NUL-terminated byte array, so a CONNECT would
+    // announce the wrong domain length and the proxy drops the request.
+    while (host_len > 0 && host[host_len - 1] == '\0') {
+        host_len--;
+    }
+
+    int n = 0;
+    buf[n++] = 5;
+    if (has_auth) {
+        buf[n++] = 2;
+        buf[n++] = 0;   // no authentication
+        buf[n++] = 2;   // username/password
+    } else {
+        buf[n++] = 1;
+        buf[n++] = 0;
+    }
+    if (socks_write(ctx, buf, n) != 0) return -1;
+    if (socks_read(ctx, buf, 2) != 0 || buf[0] != 5) return -1;
+    if (buf[1] == 0xFF) {
+        printf("[SOCKS] proxy rejected our authentication methods\n");
+        return -1;
+    }
+    if (buf[1] == 2) {
+        size_t ulen = user ? strlen(user) : 0;
+        size_t plen = pass ? strlen(pass) : 0;
+        if (!has_auth || ulen > 255 || plen > 255) return -1;
+        n = 0;
+        buf[n++] = 1;
+        buf[n++] = (unsigned char) ulen;
+        memcpy(buf + n, user, ulen);
+        n += (int) ulen;
+        buf[n++] = (unsigned char) plen;
+        if (plen) memcpy(buf + n, pass, plen);
+        n += (int) plen;
+        if (socks_write(ctx, buf, n) != 0) return -1;
+        if (socks_read(ctx, buf, 2) != 0 || buf[1] != 0) {
+            printf("[SOCKS] proxy rejected username/password\n");
+            return -1;
+        }
+    } else if (buf[1] != 0) {
+        return -1;
+    }
+
+    // Only a dotted IPv4 address is sent as an address; everything else goes
+    // as a domain so the proxy resolves it in its own region.
+    unsigned int a = 0, b = 0, c = 0, d = 0;
+    int is_ipv4 = 0;
+    if (host_len < 64) {
+        char literal[64];
+        memcpy(literal, host, host_len);
+        literal[host_len] = 0;
+        is_ipv4 = sscanf(literal, "%u.%u.%u.%u", &a, &b, &c, &d) == 4 &&
+                  a < 256 && b < 256 && c < 256 && d < 256;
+    }
+    n = 0;
+    buf[n++] = 5;
+    buf[n++] = 1;   // CONNECT
+    buf[n++] = 0;
+    if (is_ipv4) {
+        buf[n++] = 1;
+        buf[n++] = (unsigned char) a;
+        buf[n++] = (unsigned char) b;
+        buf[n++] = (unsigned char) c;
+        buf[n++] = (unsigned char) d;
+    } else {
+        if (host_len <= 0 || host_len > 255) return -1;
+        buf[n++] = 3;
+        buf[n++] = (unsigned char) host_len;
+        memcpy(buf + n, host, host_len);
+        n += host_len;
+    }
+    buf[n++] = (unsigned char) ((port >> 8) & 0xff);
+    buf[n++] = (unsigned char) (port & 0xff);
+    if (socks_write(ctx, buf, n) != 0) return -1;
+
+    if (socks_read(ctx, buf, 4) != 0 || buf[0] != 5) return -1;
+    if (buf[1] != 0) {
+        printf("[SOCKS] CONNECT refused, reply=%d\n", buf[1]);
+        return -1;
+    }
+    int skip;
+    if (buf[3] == 1) {
+        skip = 4 + 2;
+    } else if (buf[3] == 3) {
+        if (socks_read(ctx, buf, 1) != 0) return -1;
+        skip = buf[0] + 2;
+    } else if (buf[3] == 4) {
+        skip = 16 + 2;
+    } else {
+        return -1;
+    }
+    if (skip > 0 && socks_read(ctx, buf, skip) != 0) return -1;
+    return 0;
+}
