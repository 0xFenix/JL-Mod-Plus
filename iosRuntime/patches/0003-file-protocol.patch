diff --git a/minijvm/java/src/main/java/javax/microedition/io/file/FileConnectionImpl.java b/minijvm/java/src/main/java/javax/microedition/io/file/FileConnectionImpl.java
new file mode 100644
index 0000000..8c978ef
--- /dev/null
+++ b/minijvm/java/src/main/java/javax/microedition/io/file/FileConnectionImpl.java
@@ -0,0 +1,419 @@
+/*
+ * JL-Mod Plus — JSR-75 FileConnection implementation for the iOS runtime.
+ *
+ * Only the operations a MIDlet can actually observe are implemented; size
+ * queries the sandbox cannot answer (total/available/used) return 0, and
+ * permission setters are accepted as no-ops because the app sandbox grants
+ * everything inside its own directory.
+ */
+package javax.microedition.io.file;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.io.RandomAccessFile;
+import java.util.Enumeration;
+import java.util.Vector;
+
+import javax.microedition.io.Connector;
+
+public class FileConnectionImpl implements FileConnection {
+
+	private final File root;
+	private final int mode;
+	private File file;
+	private String relative;
+	private boolean directory;
+	private boolean open = true;
+
+	public FileConnectionImpl(File file, String relative, boolean directory, int mode) {
+		this.root = FileSystemRegistry.rootDirectory();
+		this.file = file;
+		this.relative = relative;
+		this.directory = directory || file.isDirectory();
+		this.mode = mode;
+	}
+
+	private void ensureOpen() throws IOException {
+		if (!open) {
+			throw new ConnectionClosedException("file connection is closed");
+		}
+	}
+
+	private void ensureFile() throws IOException {
+		ensureOpen();
+		if (directory) {
+			throw new IOException("operation not allowed on a directory: " + relative);
+		}
+		if (!file.exists()) {
+			throw new IOException("file does not exist: " + relative);
+		}
+	}
+
+	@Override
+	public boolean isOpen() {
+		return open;
+	}
+
+	@Override
+	public void close() {
+		open = false;
+	}
+
+	@Override
+	public InputStream openInputStream() throws IOException {
+		ensureFile();
+		return new FileInputStream(file);
+	}
+
+	@Override
+	public DataInputStream openDataInputStream() throws IOException {
+		return new DataInputStream(openInputStream());
+	}
+
+	@Override
+	public OutputStream openOutputStream() throws IOException {
+		ensureOpen();
+		if (directory) {
+			throw new IOException("operation not allowed on a directory: " + relative);
+		}
+		// FileOutputStream truncates, which is what the JSR-75 default overload
+		// promises for an existing file.
+		return new FileOutputStream(file);
+	}
+
+	@Override
+	public OutputStream openOutputStream(long byteOffset) throws IOException {
+		ensureOpen();
+		if (directory) {
+			throw new IOException("operation not allowed on a directory: " + relative);
+		}
+		final RandomAccessFile raf = new RandomAccessFile(file, "rw");
+		raf.seek(byteOffset);
+		return new OutputStream() {
+			@Override
+			public void write(int b) throws IOException {
+				raf.write(b);
+			}
+
+			@Override
+			public void write(byte[] buffer, int offset, int count) throws IOException {
+				raf.write(buffer, offset, count);
+			}
+
+			@Override
+			public void close() throws IOException {
+				raf.close();
+			}
+		};
+	}
+
+	@Override
+	public DataOutputStream openDataOutputStream() throws IOException {
+		return new DataOutputStream(openOutputStream());
+	}
+
+	@Override
+	public long totalSize() {
+		return 0;
+	}
+
+	@Override
+	public long availableSize() {
+		return 0;
+	}
+
+	@Override
+	public long usedSize() {
+		return 0;
+	}
+
+	@Override
+	public long directorySize(boolean includeSubDirs) throws IOException {
+		ensureOpen();
+		if (!directory) {
+			return file.length();
+		}
+		return sizeOf(file, includeSubDirs);
+	}
+
+	private static long sizeOf(File directory, boolean recursive) {
+		long total = 0;
+		File[] children = directory.listFiles();
+		if (children == null) {
+			return 0;
+		}
+		for (int i = 0; i < children.length; i++) {
+			File child = children[i];
+			if (child.isDirectory()) {
+				if (recursive) {
+					total += sizeOf(child, true);
+				}
+			} else {
+				total += child.length();
+			}
+		}
+		return total;
+	}
+
+	@Override
+	public long fileSize() throws IOException {
+		ensureFile();
+		return file.length();
+	}
+
+	@Override
+	public boolean canRead() {
+		return file.exists() ? file.canRead() : file.getParentFile().canRead();
+	}
+
+	@Override
+	public boolean canWrite() {
+		return file.exists() ? file.canWrite() : file.getParentFile().canWrite();
+	}
+
+	@Override
+	public boolean isHidden() {
+		return file.isHidden();
+	}
+
+	@Override
+	public void setReadable(boolean readable) throws IOException {
+		ensureOpen();
+	}
+
+	@Override
+	public void setWritable(boolean writable) throws IOException {
+		ensureOpen();
+	}
+
+	@Override
+	public void setHidden(boolean hidden) throws IOException {
+		ensureOpen();
+	}
+
+	@Override
+	public Enumeration list() throws IOException {
+		return list(null, false);
+	}
+
+	@Override
+	public Enumeration list(String filter, boolean includeHidden) throws IOException {
+		ensureOpen();
+		if (!directory) {
+			throw new IOException("not a directory: " + relative);
+		}
+		String[] names = file.list();
+		Vector entries = new Vector(names == null ? 0 : names.length);
+		if (names == null) {
+			return entries.elements();
+		}
+		for (int i = 0; i < names.length; i++) {
+			String child = names[i];
+			if (!includeHidden && child.startsWith(".")) {
+				continue;
+			}
+			File childFile = new File(file, child);
+			String entry = childFile.isDirectory() ? child + "/" : child;
+			if (filter != null && !matches(filter, entry)) {
+				continue;
+			}
+			entries.addElement(entry);
+		}
+		return entries.elements();
+	}
+
+	/** JSR-75 filters only understand '*' and '?'. */
+	private static boolean matches(String pattern, String value) {
+		int p = 0;
+		int v = 0;
+		int star = -1;
+		int mark = 0;
+		while (v < value.length()) {
+			if (p < pattern.length() && (pattern.charAt(p) == '?' || pattern.charAt(p) == value.charAt(v))) {
+				p++;
+				v++;
+			} else if (p < pattern.length() && pattern.charAt(p) == '*') {
+				star = p++;
+				mark = v;
+			} else if (star >= 0) {
+				p = star + 1;
+				v = ++mark;
+			} else {
+				return false;
+			}
+		}
+		while (p < pattern.length() && pattern.charAt(p) == '*') {
+			p++;
+		}
+		return p == pattern.length();
+	}
+
+	@Override
+	public void create() throws IOException {
+		ensureOpen();
+		if (file.exists()) {
+			throw new IOException("already exists: " + relative);
+		}
+		File parent = file.getParentFile();
+		if (parent != null && !parent.exists()) {
+			throw new IOException("parent directory does not exist: " + relative);
+		}
+		if (!file.createNewFile()) {
+			throw new IOException("cannot create: " + relative);
+		}
+		directory = false;
+	}
+
+	@Override
+	public void mkdir() throws IOException {
+		ensureOpen();
+		if (file.exists()) {
+			throw new IOException("already exists: " + relative);
+		}
+		if (!file.mkdir()) {
+			throw new IOException("cannot create directory: " + relative);
+		}
+		directory = true;
+	}
+
+	@Override
+	public boolean exists() {
+		return file.exists();
+	}
+
+	@Override
+	public boolean isDirectory() {
+		return file.isDirectory();
+	}
+
+	@Override
+	public void delete() throws IOException {
+		ensureOpen();
+		if (!file.exists()) {
+			throw new IOException("does not exist: " + relative);
+		}
+		String[] children = file.isDirectory() ? file.list() : null;
+		if (children != null && children.length > 0) {
+			throw new IOException("directory not empty: " + relative);
+		}
+		if (!file.delete()) {
+			throw new IOException("cannot delete: " + relative);
+		}
+	}
+
+	@Override
+	public void rename(String newName) throws IOException {
+		ensureOpen();
+		if (newName == null || newName.length() == 0
+				|| newName.indexOf('/') >= 0 || newName.indexOf('\\') >= 0) {
+			throw new IllegalArgumentException("invalid file name: " + newName);
+		}
+		File parent = file.getParentFile();
+		File target = new File(parent, newName);
+		if (target.exists()) {
+			throw new IOException("target exists: " + newName);
+		}
+		if (!file.renameTo(target)) {
+			throw new IOException("cannot rename: " + relative);
+		}
+		file = target;
+		relative = relativeToRoot(target);
+		directory = file.isDirectory();
+	}
+
+	@Override
+	public void truncate(long byteOffset) throws IOException {
+		ensureFile();
+		if (byteOffset < 0 || byteOffset > file.length()) {
+			throw new IOException("invalid truncate offset: " + byteOffset);
+		}
+		RandomAccessFile raf = new RandomAccessFile(file, "rw");
+		try {
+			raf.setLength(byteOffset);
+		} finally {
+			raf.close();
+		}
+	}
+
+	@Override
+	public void setFileConnection(String name) throws IOException {
+		ensureOpen();
+		File target;
+		if (name == null || name.equals("..")) {
+			target = file.getParentFile();
+			if (target == null || !isInsideRoot(target)) {
+				throw new IOException("cannot go above the root directory");
+			}
+		} else if (name.length() == 0 || name.equals(".")) {
+			target = file;
+		} else {
+			if (name.indexOf('/') >= 0 || name.indexOf('\\') >= 0) {
+				throw new IOException("invalid child name: " + name);
+			}
+			target = new File(file, name);
+			if (!isInsideRoot(target)) {
+				throw new IOException("path escapes the root directory");
+			}
+		}
+		if (!target.exists()) {
+			throw new IOException("does not exist: " + name);
+		}
+		file = target;
+		relative = relativeToRoot(target);
+		directory = target.isDirectory();
+	}
+
+	private String canonicalPath(File candidate) {
+		try {
+			return candidate.getCanonicalPath();
+		} catch (IOException failure) {
+			return candidate.getAbsolutePath();
+		}
+	}
+
+	private boolean isInsideRoot(File candidate) {
+		String base = canonicalPath(root);
+		String path = canonicalPath(candidate);
+		return path.equals(base) || path.startsWith(base.endsWith(File.separator) ? base : base + File.separator);
+	}
+
+	/** Path relative to the root, with {@code ..} resolved by the file system. */
+	private String relativeToRoot(File candidate) {
+		String base = canonicalPath(root);
+		String path = canonicalPath(candidate);
+		if (path.equals(base)) {
+			return "";
+		}
+		if (path.startsWith(base.endsWith(File.separator) ? base : base + File.separator)) {
+			int start = base.length() + (base.endsWith(File.separator) ? 0 : 1);
+			return path.substring(start);
+		}
+		return path;
+	}
+
+	@Override
+	public String getName() {
+		return directory ? relative + "/" : relative;
+	}
+
+	@Override
+	public String getPath() {
+		return "/root/" + (directory && relative.length() > 0 ? relative + "/" : relative);
+	}
+
+	@Override
+	public String getURL() {
+		return "file:///root/" + (directory && relative.length() > 0 ? relative + "/" : relative);
+	}
+
+	@Override
+	public long lastModified() {
+		return file.lastModified();
+	}
+}
