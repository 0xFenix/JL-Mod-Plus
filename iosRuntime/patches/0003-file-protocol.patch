diff --git a/minijvm/java/src/main/java/org/mini/net/file/Protocol.java b/minijvm/java/src/main/java/org/mini/net/file/Protocol.java
new file mode 100644
index 0000000..34ea52b
--- /dev/null
+++ b/minijvm/java/src/main/java/org/mini/net/file/Protocol.java
@@ -0,0 +1,97 @@
+/*
+ * JL-Mod Plus — JSR-75 file protocol for the iOS runtime.
+ *
+ * The miniJVM boot classpath owns javax.microedition.io.Connector and resolves
+ * a protocol by loading "<protocolpath>.<scheme>.Protocol" with Class.forName,
+ * so a classpath class in the same package path is enough: no engine patch and
+ * no jar rebuild is needed for file:// support.
+ */
+package org.mini.net.file;
+
+import com.sun.cldc.io.ConnectionBaseInterface;
+
+import java.io.File;
+import java.io.IOException;
+
+import javax.microedition.io.Connection;
+import javax.microedition.io.ConnectionNotFoundException;
+import javax.microedition.io.file.FileConnection;
+import javax.microedition.io.file.FileConnectionImpl;
+import javax.microedition.io.file.FileSystemRegistry;
+
+/**
+ * Handles {@code file:///root/...} URLs and maps the single {@code root} file
+ * system onto a writable directory inside the app sandbox.
+ */
+public class Protocol implements ConnectionBaseInterface {
+
+    public static final String ROOT_NAME = "root";
+
+    @Override
+    public Connection openPrim(String name, int mode, boolean timeouts) throws IOException {
+        if (name == null || !name.startsWith("//")) {
+            throw new IOException("bad file connection name: " + name);
+        }
+        // MIDP spells the URL file:///<root>/<path>, so Connector hands over
+        // "///<root>/<path>" with one separator more than a socket URL.
+        String rest = name.startsWith("///") ? name.substring(3) : name.substring(2);
+        int slash = rest.indexOf('/');
+        String rootName = slash < 0 ? rest : rest.substring(0, slash);
+        if (!ROOT_NAME.equalsIgnoreCase(rootName)) {
+            throw new ConnectionNotFoundException("unknown file root: " + rootName);
+        }
+        String path = slash < 0 ? "" : rest.substring(slash + 1);
+        path = decode(path);
+        if (!isSafe(path)) {
+            throw new IOException("invalid file path: " + path);
+        }
+        boolean directory = slash < 0 || path.length() == 0 || path.endsWith("/");
+        String clean = path.endsWith("/") ? path.substring(0, path.length() - 1) : path;
+
+        File target = clean.length() == 0
+                ? FileSystemRegistry.rootDirectory()
+                : new File(FileSystemRegistry.rootDirectory(), clean);
+        return new FileConnectionImpl(target, clean, directory, mode);
+    }
+
+    /** Rejects traversal so a game cannot walk out of the sandboxed root. */
+    private static boolean isSafe(String path) {
+        if (path.indexOf('\0') >= 0) {
+            return false;
+        }
+        int start = 0;
+        while (start <= path.length()) {
+            int end = path.indexOf('/', start);
+            if (end < 0) {
+                end = path.length();
+            }
+            String part = path.substring(start, end);
+            if (part.equals("..")) {
+                return false;
+            }
+            start = end + 1;
+        }
+        return true;
+    }
+
+    private static String decode(String value) {
+        if (value.indexOf('%') < 0) {
+            return value;
+        }
+        StringBuffer out = new StringBuffer(value.length());
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c == '%' && i + 2 < value.length()) {
+                int hi = Character.digit(value.charAt(i + 1), 16);
+                int lo = Character.digit(value.charAt(i + 2), 16);
+                if (hi >= 0 && lo >= 0) {
+                    out.append((char) ((hi << 4) + lo));
+                    i += 2;
+                    continue;
+                }
+            }
+            out.append(c);
+        }
+        return out.toString();
+    }
+}
