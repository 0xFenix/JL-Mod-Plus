--- /dev/null
+++ b/minijvm/java/src/main/java/javax/microedition/io/file/FileSystemRegistry.java
@@ -0,0 +1,63 @@
+/*
+ * Derived from J2ME-Decade (iOS Edition) <https://github.com/darkrose00x-ux/j2me-ios>,
+ * licensed under the Apache License, Version 2.0. That project states its J2ME API
+ * layer is ported from J2ME-Loader <https://github.com/nikita36078/J2ME-Loader>,
+ * whose javax.microedition sources are Copyright 2012 Kulikov Dmitriy,
+ * 2017-2020 Nikita Shakarun, 2019-2023 Yury Kharchenko, Apache License 2.0.
+ *
+ * JL-Mod Plus modifications: removed the M3G (javax.microedition.m3g), MascotCapsule
+ * micro3D, JBlend/Vodafone J3D, Bluetooth, Location and AMMS packages, which are
+ * outside the iOS runtime scope. The registry previously reported no roots; it now
+ * exposes one sandboxed root implemented by org.mini.net.file.Protocol.
+ */
+package javax.microedition.io.file;
+
+import java.io.File;
+import java.util.Enumeration;
+import java.util.Vector;
+
+/**
+ * Exposes a single {@code root} file system backed by a writable directory in
+ * the app sandbox. The sandbox path comes from the {@code app.save.root}
+ * property the bridge sets for RMS; files live in a sibling {@code files}
+ * directory so game data and record stores never mix.
+ */
+public class FileSystemRegistry {
+
+	private static File root;
+
+	public static boolean addFileSystemListener(FileSystemListener listener) {
+		// The sandbox never gains or loses roots at runtime.
+		return false;
+	}
+
+	public static boolean removeFileSystemListener(FileSystemListener listener) {
+		return false;
+	}
+
+	public static Enumeration listRoots() {
+		Vector roots = new Vector(1);
+		roots.addElement("root/");
+		return roots.elements();
+	}
+
+	/** Directory behind {@code file:///root/}; created on first use. */
+	public static File rootDirectory() {
+		if (root == null) {
+			File base = null;
+			String save = System.getProperty("app.save.root");
+			if (save != null && save.length() > 0) {
+				base = new File(save).getParentFile();
+			}
+			if (base == null) {
+				base = new File(".");
+			}
+			File files = new File(base, "files");
+			if (!files.exists()) {
+				files.mkdirs();
+			}
+			root = files;
+		}
+		return root;
+	}
+}
