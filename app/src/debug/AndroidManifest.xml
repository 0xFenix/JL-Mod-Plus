<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="io.github.h3nb.sonivox.productionfocusrival" />
    </queries>

    <application tools:ignore="GoogleAppIndexingWarning,MissingApplicationIcon">
        <service
            android:name="io.github.h3nb.jlmodplus.settings.RuntimeChromeProbeService"
            android:exported="false"
            android:process=":fullscreen_probe" />
        <activity
            android:name="io.github.h3nb.jlmodplus.mmapi.synth.AudioQualificationActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="javax.microedition.shell.AudioRuntimeRecreationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":midlet" />
        <activity
            android:name="javax.microedition.shell.MidletLocaleProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":locale_probe" />
        <activity
            android:name="io.github.h3nb.jlmodplus.crashes.CrashRuntimeProbeActivity"
            android:taskAffinity="${applicationId}.crash_probe"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":midlet" />
        <activity
            android:name="io.github.h3nb.jlmodplus.runtime.slots.debug.RuntimeSlot0ProbeActivity"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":midlet0"
            android:taskAffinity="${applicationId}.runtime.slot0"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="io.github.h3nb.jlmodplus.runtime.slots.debug.RuntimeSlot1ProbeActivity"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":midlet1"
            android:taskAffinity="${applicationId}.runtime.slot1"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="javax.microedition.shell.CrashRuntimeLifecycleControlActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":midlet" />
        <service
            android:name="javax.microedition.shell.PresetAuthorityProbeService"
            android:exported="false"
            android:process=":midlet" />
        <service
            android:name="io.github.h3nb.jlmodplus.config.PresetAuthorityMainProbeService"
            android:exported="false" />
    </application>

</manifest>
